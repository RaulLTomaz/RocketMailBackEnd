# Copie para .env.test e ajuste o banco local de testes.
# NÃO versionar .env.test (contém secrets locais).

PYTHON_ENV=test

# Postgres dedicado a testes (não use o banco de desenvolvimento)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rocketmail_test

# Apenas para ambiente de teste local
SECRET_KEY=test_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120
