# Copie para .env para rodar localmente. Em produção (Render) isso vem do render.yaml.
PYTHON_ENV=dev

# Gere um valor forte (ex.: `openssl rand -hex 32`)
SECRET_KEY=changeme_super_secret

# Tempo de vida do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL local: ajuste usuário, senha e nome do banco conforme a sua máquina
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rocketmail

# Em produção (Render), o DATABASE_URL já vem com SSL; localmente SSL fica desligado
# quando PYTHON_ENV=dev. Force SSL com DATABASE_SSL=1 se necessário.
# DATABASE_SSL=0
