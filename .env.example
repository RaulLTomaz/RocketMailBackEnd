# Copie para .env para rodar localmente. Em produção (Render) isso vem do render.yaml / dashboard.
PYTHON_ENV=dev

# Gere um valor forte (ex.: `openssl rand -hex 32`)
SECRET_KEY=changeme_super_secret

# Tempo de vida do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL local: ajuste usuário, senha e nome do banco conforme a sua máquina
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rocketmail

# URL pública da API (fallback de uploads locais em dev)
PUBLIC_BASE_URL=http://localhost:8000

# --- Fotos de perfil ---
# Em PRODUÇÃO (Render) Cloudinary é OBRIGATÓRIO — disco local some no redeploy.
# 1) Crie conta em https://cloudinary.com (plano free)
# 2) Dashboard → API Keys → copie o "API environment variable" (CLOUDINARY_URL)
# 3) No Render → Environment → adicione:
#      CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
#
# Alternativa (3 vars):
# CLOUDINARY_CLOUD_NAME=seu_cloud
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
#
# Em dev/test, sem Cloudinary, o upload usa disco local /media/avatars.

# Em produção (Render), o DATABASE_URL já vem com SSL; localmente SSL fica desligado
# quando PYTHON_ENV=dev. Force SSL com DATABASE_SSL=1 se necessário.
# DATABASE_SSL=0
#
# Render usa certificado que falha na verificação estrita — por padrão não verificamos CA.
# Só ative se tiver CA válida: DATABASE_SSL_VERIFY=1
